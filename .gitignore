__pycache__/
*.pyc

# Build artefacts
/veduta
/dist
**/target/

# Node
node_modules/
# The build output is generated, but one placeholder is committed so `go build` works on a
# clean clone: //go:embed needs at least one matching file.
web/build/*
!web/build/.gitkeep

# Local state. /config and /secrets are where compose.yaml puts a real deployment's configuration
# and its password-hash file if you run it from a source checkout; neither belongs in git.
/config
/secrets
/data
*.db
*.db-wal
*.db-shm
.env

# Captured upstream fixtures are reviewed by hand before committing (see hack/capture-upstream-fixtures.sh)
testdata/upstream/

# Playwright: baselines under web/tests/*-snapshots/ ARE committed; run output is not.
web/test-results/
web/playwright-report/
web/blob-report/
